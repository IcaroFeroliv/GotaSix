@page "/forgot-password"
@using GotaSix.Models
@using GotaSix.Layout
@layout EmptyLayout

<div class="auth-wrapper">
    <div class="auth-brand-panel">
        <div class="brand-logo-large">💧</div>
        <h2 class="brand-title-large">Recuperação</h2>
        <p class="brand-description">Não se preocupe! Acontece com os melhores. Vamos te ajudar a redefinir seu acesso de forma segura.</p>
    </div>

    <div class="auth-form-panel">
        <a href="/login" class="back-link">← Voltar para o login</a>

        <div class="auth-header">
            <h1 class="auth-title">Esqueceu sua senha?</h1>
            <p class="auth-subtitle">Insira o e-mail associado à sua conta e enviaremos um link para redefinir sua senha.</p>
        </div>

        @if (emailEnviado)
        {
            <div style="background-color: #dcfce7; color: #15803d; padding: 15px; border-radius: 8px; font-size: 14px; margin-bottom: 20px; font-weight: 500;">
                ✓ Se o e-mail estiver cadastrado, você receberá um link de recuperação em instantes!
            </div>
        }

        <EditForm Model="@forgotModel" OnValidSubmit="HandleForgotPassword">
            <DataAnnotationsValidator />

            <div class="form-group">
                <label>E-mail cadastrado</label>
                <InputText @bind-Value="forgotModel.Email" class="form-control" placeholder="seu@email.com" />
                <ValidationMessage For="@(() => forgotModel.Email)" style="color: #dc2626; font-size: 13px;" />
            </div>

            <button type="submit" class="btn-primary">Enviar link de recuperação</button>
        </EditForm>
    </div>
</div>

@code {
    private ForgotPasswordRequest forgotModel = new ForgotPasswordRequest();
    private bool emailEnviado = false;

    private void HandleForgotPassword()
    {
        Console.WriteLine($"Solicitada recuperação de senha para: {forgotModel.Email}");
        emailEnviado = true; // Ativa o alerta verde de sucesso na tela
    }
}